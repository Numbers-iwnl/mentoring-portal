# MySQL connection. For local development any MySQL/MariaDB database works.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# First admin account created by `npm run db:seed`.
SEED_ADMIN_NAME="Aurora Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# SMTP mailbox for password recovery e-mails.
# Without these, the "Esqueci minha senha" flow stays disabled gracefully.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="<senha-da-caixa>"
SMTP_FROM="Aurora Mentoring <no-reply@example.com>"
