generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
  STAFF
}

enum EntrySource {
  MANUAL
  IMPORT
}

enum StudentUnitType {
  CLINIC
  MENTORSHIP
  OTHER
}

enum ClinicExpenseCategory {
  EMPLOYEES
  THIRD_PARTY
  STRUCTURE
  CONSUMPTION
  VARIABLE
  INVESTMENT
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(STUDENT)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  permissions        Json?
  studentId    String?
  student      Student?   @relation(fields: [studentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  financeEntries FinanceEntry[] @relation("FinanceEntryCreatedBy")
  messageEntries MessageEntry[] @relation("MessageEntryCreatedBy")
  auditLogs    AuditLog[]

  @@index([studentId])
}

model Student {
  id                    String         @id @default(cuid())
  name                  String
  clinicName            String?
  email                 String?
  phone                 String?
  active                Boolean        @default(true)
  paymentChannelEnabled Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  users                 User[]
  units                 StudentUnit[]
  financeEntries        FinanceEntry[]
  messageEntries        MessageEntry[]
  auditLogs             AuditLog[]

  @@index([active])
}

model StudentUnit {
  id             String          @id @default(cuid())
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           StudentUnitType
  name           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  financeEntries FinanceEntry[]
  messageEntries MessageEntry[]
  clinicCostSetting ClinicCostSetting?
  clinicExpenseItems ClinicExpenseItem[]
  clinicRoomHours ClinicRoomHour[]

  @@unique([studentId, type])
  @@index([studentId, active])
}

model ClinicCostSetting {
  unitId              String      @id
  unit                StudentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  weeksPerMonth       Decimal     @default(4) @db.Decimal(5, 2)
  idleDiscountPercent Decimal     @default(20) @db.Decimal(5, 2)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model ClinicExpenseItem {
  id        String                @id @default(cuid())
  unitId    String
  unit      StudentUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  category  ClinicExpenseCategory
  label     String
  amount    Decimal               @default(0) @db.Decimal(12, 2)
  sortOrder Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([unitId, sortOrder])
  @@index([unitId, category])
}

model ClinicRoomHour {
  id        String      @id @default(cuid())
  unitId    String
  unit      StudentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  roomName  String
  monday    Decimal     @default(0) @db.Decimal(6, 2)
  tuesday   Decimal     @default(0) @db.Decimal(6, 2)
  wednesday Decimal     @default(0) @db.Decimal(6, 2)
  thursday  Decimal     @default(0) @db.Decimal(6, 2)
  friday    Decimal     @default(0) @db.Decimal(6, 2)
  saturday  Decimal     @default(0) @db.Decimal(6, 2)
  sunday    Decimal     @default(0) @db.Decimal(6, 2)
  sortOrder Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([unitId, sortOrder])
  @@index([unitId])
}

model FinanceEntry {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          StudentUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  date          DateTime
  patientName   String?
  /// Descrição livre da venda (era "Tipo de atendimento" antes de existir serviceType).
  treatment     String?
  serviceType   String?
  specialty     String?
  total         Decimal     @db.Decimal(12, 2)
  cash          Decimal     @default(0) @db.Decimal(12, 2)
  pix           Decimal     @default(0) @db.Decimal(12, 2)
  card          Decimal     @default(0) @db.Decimal(12, 2)
  installments  String?
  transfer      Decimal     @default(0) @db.Decimal(12, 2)
  payments      Json?
  professional  String?
  closer        String?
  observations  String?     @db.Text
  refundAmount  Decimal     @default(0) @db.Decimal(12, 2)
  refundedAt    DateTime?
  source        EntrySource @default(MANUAL)
  sourceSheet   String?
  sourceRow     Int?
  importedAt    DateTime?
  createdById   String?
  createdBy     User?       @relation("FinanceEntryCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([studentId, date])
  @@index([unitId, date])
  @@index([source, sourceSheet])
  @@index([refundedAt])
}

model MessageEntry {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          StudentUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  date          DateTime
  name          String?
  contact       String?
  type          String?
  channel       String?
  scheduledBy   String?
  professional  String?
  reason        String?
  scheduled     Boolean?
  attended      String?
  approach      String?
  discardStatus String?
  discardReason String?
  discardReasonOther String?
  bookedTreatment Boolean?
  status        String?
  observations  String?     @db.Text
  source        EntrySource @default(MANUAL)
  sourceSheet   String?
  sourceRow     Int?
  importedAt    DateTime?
  createdById   String?
  createdBy     User?       @relation("MessageEntryCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([studentId, date])
  @@index([unitId, date])
  @@index([scheduled])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([userId, createdAt])
}

model ImportBatch {
  id             String   @id @default(cuid())
  sourceFile     String
  sourceLabel    String
  expectedTotals Json
  result         Json
  createdAt      DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
